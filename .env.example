# =============================================================================
# SwiftDoc — environment variable reference
#
# Copy this file to .env.local for local development.
# For production / staging deployments, set these in Vercel environment
# variables (Settings → Environment Variables).
#
# Never commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service-role key — server-side only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# -----------------------------------------------------------------------------
# Skyvern browser-agent API
#
# Sign up at https://app.skyvern.com and create an API key.
# The default base URL points to Skyvern Cloud; self-hosted instances
# can override SKYVERN_BASE_URL.
# -----------------------------------------------------------------------------
SKYVERN_API_KEY=<your-skyvern-api-key>
SKYVERN_BASE_URL=https://api.skyvern.com

# HMAC secret for validating incoming Skyvern webhook callbacks.
# Generate with: openssl rand -hex 32
# Register the same value in the Skyvern dashboard → Webhook Settings.
SKYVERN_WEBHOOK_SECRET=<32-byte-hex-secret>

# -----------------------------------------------------------------------------
# Tradelink / Ge-TS portal URL
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  PENDING: Tradelink staging access not yet granted (as of 2025-05)      │
# │                                                                          │
# │  TRADELINK_PORTAL_URL is currently set to a placeholder.                │
# │  Once staging access is approved, replace the value below with the      │
# │  real Ge-TS staging URL provided by Tradelink / CEDB.                  │
# │                                                                          │
# │  For production, update to the production portal URL.                   │
# │                                                                          │
# │  Also update the navigation goal in:                                     │
# │    src/lib/filing/navigation.ts → buildNavigationGoal()                 │
# │  if the actual portal UI differs from the current instructions.          │
# └──────────────────────────────────────────────────────────────────────────┘
#
# PLACEHOLDER — replace once Tradelink staging credentials are issued:
TRADELINK_PORTAL_URL=https://staging.tradelink.com.hk

# Tradelink environment toggle ("staging" or "production").
# Controls which credential row is fetched from Supabase for a given tenant.
TRADELINK_ENVIRONMENT=staging

# -----------------------------------------------------------------------------
# Filing pipeline
# -----------------------------------------------------------------------------

# Secret used to authenticate cron-initiated filing requests.
# Any request to POST /api/filing/trigger with:
#   Authorization: Bearer <FILING_CRON_SECRET>
# is treated as a trusted server-to-server call and bypasses session auth.
# Generate with: openssl rand -hex 32
FILING_CRON_SECRET=<32-byte-hex-secret>

# -----------------------------------------------------------------------------
# Gemini 1.5 Pro (waybill extraction)
#
# Used by POST /api/waybill/extract to parse mixed Cantonese/English waybill
# documents and resolve HKHS commodity codes.
#
# Obtain an API key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=<your-gemini-api-key>

# -----------------------------------------------------------------------------
# App URL (used to build absolute webhook callback URLs for Skyvern)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# -----------------------------------------------------------------------------
# Postmark (email notifications)
# -----------------------------------------------------------------------------
POSTMARK_SERVER_API_TOKEN=<your-postmark-server-token>
POSTMARK_FROM_EMAIL=noreply@yourdomain.com
# Optional — defaults to "outbound"
POSTMARK_MESSAGE_STREAM=outbound
